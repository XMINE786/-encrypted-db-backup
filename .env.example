# Master passphrase used to derive the AES-256 key that encrypts
# database credentials (at rest) and every backup file.
# Use a long random value. If you lose this, backups CANNOT be decrypted.
BACKUP_ENCRYPTION_KEY=change-me-to-a-long-random-secret

# Where encrypted backup files and the SQLite metadata DB are stored.
# Defaults to ./data
DATA_DIR=./data

# Secret used to sign login session cookies (HMAC). Optional — if unset, a
# stable secret is derived from BACKUP_ENCRYPTION_KEY. Set a long random value
# to be able to rotate it independently.
# NOTE: set this BEFORE `npm run build` so the same secret is used at build
# and runtime (Next.js reads env for middleware at build for edge targets).
AUTH_SECRET=

# Set to 1 ONLY when serving over plain HTTP on a trusted/internal network.
# It drops the Secure flag on the session cookie so login works without HTTPS.
# Leave unset for any internet-facing deployment and terminate HTTPS instead.
ALLOW_INSECURE_COOKIES=
